    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Target the full body text from the 'Get a message' node\nconst emailBody = $json.text || \"\";\n\n// 2. Extraction helper - uses the labels in email as anchors\nconst extract = (startLabel, endLabel) => {\n  const parts = emailBody.split(startLabel);\n  if (parts.length < 2) return \"N/A\";\n  const content = parts[1].split(endLabel)[0];\n  return content.trim();\n};\n\n// 3. Precise Date/Time Logic\n// Using the ISO date n8n already provided in JSON\nconst emailDate = new Date($json.date);\nconst dateStr = emailDate.toLocaleDateString(\"en-US\", { timeZone: \"America/Los_Angeles\" });\nconst timeStr = emailDate.toLocaleTimeString(\"en-US\", { \n  timeZone: \"America/Los_Angeles\", \n  hour: '2-digit', \n  minute: '2-digit' \n});\n\n// 4. Map the 11 fields from Google Sheets\nreturn {\n  name: extract(\"request from \", \":\"),\n  date: dateStr,\n  time: timeStr,\n  phone: extract(\"Phone #: \", \"Preferred Date 1:\"),\n  date1: extract(\"Preferred Date 1: \", \"Availability for Date 1:\"),\n  avail1: extract(\"Availability for Date 1: \", \"Preferred Date 2:\"),\n  date2: extract(\"Preferred Date 2: \", \"Availability for Date 2:\"),\n  avail2: extract(\"Availability for Date 2: \", \"Preferred Date 3:\"),\n  date3: extract(\"Preferred Date 3: \", \"Availability for Date 3:\"),\n  avail3: extract(\"Availability for Date 3: \", \"Description of Haircut\"),\n  description: extract(\"Other Comments:\", \"Best wishes\")\n};"
      },
