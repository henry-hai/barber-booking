# Dependencies
node_modules/

# Build output
dist/

# Sensitive credentials
serverInfo.json
serviceAccount.json

# Client data the one-off scripts pull out of the sheet. Both of them write
# next to themselves by default, and neither output belongs in the repo.
server/scripts/*.json
server/scripts/*.tsv

# OS files
Thumbs.db
.DS_Store

# Local notes
barber-booking_project_context.md
HANDOFF.md

# Test output
playwright-report/
test-results/

# AWS build and test output
infra/.aws-sam/
infra/.venv/
infra/.pytest_cache/
__pycache__/

# The static export of the site, built only for S3
web/out/

# Generated test-stage credentials, never committed
*.local.json
