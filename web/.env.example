# Build-time configuration for the public site.
#
# Copy to .env.local for local development. Both are NEXT_PUBLIC_, so their
# values are inlined into the client bundle at build time: they are addresses,
# not secrets, and nothing sensitive belongs in this file.
#
# On Vercel these are set under Project Settings -> Environment Variables, and
# a change to either one only takes effect on the next deployment.

# Where the booking form posts. The Express API lives on its own host because
# it holds a long-lived IMAP connection, which does not fit a serverless
# function. Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Canonical origin for metadata: og:url, the sitemap and robots.txt all derive
# from it. Point it at wherever the site is actually served, or search engines
# are told to index an address that is not this one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
